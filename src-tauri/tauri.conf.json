{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TattingCAD",
  "version": "1.4.1",
  "identifier": "com.savarosa.tattingcad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
"app": {
    "windows": [
      {
      "label": "main",
      "title": "TattingCAD",
      "width": 800,
      "height": 600,
      "resizable": true,
      "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
	"category": "GraphicsAndDesign",
	"shortDescription": "Tatting pattern designer",
	"longDescription": "A full-featured design tool for needle and shuttle tatting patterns.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../dist/*.json",
      "../dist/*.md",
      "../dist/*.html",
      "icons/tatcad-document.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["tatcad"],
        "name": "TattingCAD Pattern",
        "description": "TattingCAD pattern",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-tatcad",
        "exportedType": {
          "identifier": "com.savarosa.tattingcad.pattern",
          "conformsTo": ["public.json"]
        }
      }
    ],
	"windows": {
		"nsis": {
			"installerIcon": "icons/icon.ico",
			"sidebarImage": "icons/installer-sidebar.bmp",
			"installerHooks": "windows/hooks.nsh"
				}
			},
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop",
        "files": {
          "/usr/share/mime/packages/tattingcad.xml": "linux/tattingcad-mime.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-tatcad.png": "icons/tatcad-document-256.png"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  },

    
"plugins": {
    "window-state": null,
"opener": {}
  }
}
